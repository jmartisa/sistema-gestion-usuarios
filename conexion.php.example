<?php
// ==========================================
// CONFIGURACIÓN DE CONEXIÓN A LA BASE DE DATOS
// ==========================================
// ️ COPIA ESTE ARCHIVO COMO 'conexion.php' Y AJUSTA TUS CREDENCIALES

$host = '127.0.0.1';
$database = 'sistemasgd'; // Cambia por el nombre de tu BD
$user = 'root';            // Cambia por tu usuario
$password = '';            // Cambia por tu contraseña

try {
    $options = [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        PDO::ATTR_EMULATE_PREPARES   => false,
    ];
    $dsn = "mysql:host=$host;dbname=$database;charset=utf8mb4";
    $con = new PDO($dsn, $user, $password, $options);
} catch (PDOException $e) {
    error_log("Error de conexión a BD: " . $e->getMessage());
    die("Error al conectar con el sistema. Por favor, intente más tarde.");
}
?>